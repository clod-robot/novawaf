# NovaWAF 运行配置（安装后位于 /opt/novawaf/novawaf.env）
# 端口
ENGINE_PORT=8099          # 检测引擎监听端口（网关反代目标）
ENGINE_THREADS=4          # 引擎工作线程数
ADMIN_PORT=18081          # 管理后端端口
# Redis（规则热加载 / 事件落库 / 统计，需本机或远程可达）
NOVA_REDIS_HOST=127.0.0.1
NOVA_REDIS_PORT=6379
NOVA_REDIS_PASS=
NOVA_REDIS_DB=0
# 规则数据
NOVA_YARA_RULES=/opt/novawaf/rules/yara
# 地理围栏（可选，逗号分隔国家代码）
NOVA_GEO_BLOCK=
NOVA_GEO_ALLOW=
# 上游业务网关（引擎转发目标，由引擎内 apps 配置/Redis 决定，此处仅备忘）
# UPSTREAM_HOST=127.0.0.1  UPSTREAM_PORT=8080
