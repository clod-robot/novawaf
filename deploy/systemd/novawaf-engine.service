[Unit]
Description=NovaWAF Engine (reverse-proxy WAF on :8099, master/worker supervise)
After=network-online.target redis.service
Wants=network-online.target
# 永远不让它因反复失败被 systemd 放弃
StartLimitIntervalSec=0

[Service]
Type=simple
User=mao
Group=mao
WorkingDirectory=/home/mao/novawaf/engine
# 引擎环境变量集中在此文件（密钥不入库，权限 root:mao 0640）：
#   NOVA_REDIS_HOST/NOVA_REDIS_PASS/NOVA_TRUSTED_PROXIES/NOVA_SLOW_REQ_MS/
#   NOVA_YARA_RULES/NOVA_STATS_FLUSH_MS/NOVA_RMI_GUARD_*/NOVA_RUN_DIR 等
EnvironmentFile=-/etc/novawaf/novawaf-engine.env
# current 为版本符号链接（/opt/novawaf/engine/current -> versions/<ver>/novawaf-engine）。
# --supervise = nginx 式 master/worker：SIGUSR2 零停机滚动重启，管理端一键升级/回退依赖它。
ExecStart=/opt/novawaf/engine/current --supervise 8099 4
Restart=always
RestartSec=1
# 资源保护：防异常内存吃光导致整机死机
MemoryMax=1024M
MemoryHigh=768M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
